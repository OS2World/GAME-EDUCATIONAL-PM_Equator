DLGTEMPLATE ID_LEVEL LOADONCALL DISCARDABLE MOVEABLE
BEGIN
    DIALOG "Adjust Level", ID_LEVEL, 46, 41, 120, 63, WS_VISIBLE, FCF_SYSMENU | FCF_TITLEBAR
    BEGIN
        RTEXT "Upper Level", -1, 8, 47, 52, 9
        RTEXT "Lower Level", -1, 8, 27, 52, 9
        DEFPUSHBUTTON "OK", DID_OK, 9, 5, 51, 14
        PUSHBUTTON "~Cancel", DID_CANCEL, 63, 5, 51, 14
        CONTROL "", DID_LEVEL2, 64, 28, 47, 12, WC_SPINBUTTON, SPBS_MASTER | SPBS_NUMERICONLY | SPBS_JUSTCENTER | WS_VISIBLE | WS_GROUP | WS_TABSTOP
        CONTROL "", DID_LEVEL, 64, 48, 47, 12, WC_SPINBUTTON, SPBS_MASTER | SPBS_NUMERICONLY | SPBS_JUSTCENTER | WS_VISIBLE | WS_GROUP | WS_TABSTOP
    END
END

DLGTEMPLATE ID_DIGIT LOADONCALL DISCARDABLE MOVEABLE
BEGIN
    DIALOG "Guess Digit", ID_DIGIT, 46, 41, 90, 50, WS_VISIBLE, FCF_SYSMENU | FCF_TITLEBAR
    BEGIN
        ICON ID_ClientWindow, -1, 3, 4, 32, 32
        DEFPUSHBUTTON "OK", DID_OK, 44, 6, 41, 14
        GROUPBOX "Which digit?", -1, 9, 23, 71, 25
        CONTROL "", DID_DIGIT, 44, 26, 32, 12, WC_SPINBUTTON, SPBS_MASTER | SPBS_NUMERICONLY | SPBS_JUSTCENTER | WS_VISIBLE | WS_GROUP | WS_TABSTOP
        CONTROL IDB_HBMAL0, ID_DIGICON, 13, 26, 32, 32, WC_STATIC, SS_BITMAP | WS_VISIBLE
    END
END

DLGTEMPLATE ID_GETNAME LOADONCALL DISCARDABLE MOVEABLE
BEGIN
    DIALOG "Enter your Name", ID_GETNAME, 46, 41, 180, 70, WS_VISIBLE, FCF_TITLEBAR
    BEGIN
        ICON ID_ClientWindow, -1, 5, 45, 32, 32
        DEFPUSHBUTTON "OK", DID_OK, 3, 6, 32, 32
        COMBOBOX "", DID_GETNAME, 38, 4, 133, 58, CBS_SIMPLE | WS_VISIBLE
    END
END

DLGTEMPLATE ID_HELLO PRELOAD DISCARDABLE
BEGIN
    DIALOG "About Equator", ID_HELLO, 86, 81, 220, 112, WS_VISIBLE, FCF_TITLEBAR
    BEGIN
        ICON ID_ClientWindow, -1, 10, 76, 32, 32
        CTEXT "Equator", -1, 55, 94, 150, 16, DT_VCENTER
        CTEXT "Version 1.0", -1, 55, 78, 150, 10, DT_VCENTER
        CTEXT "(c) 1995-2001 Frank Sven Nestel", -1, 55, 60, 150, 10, DT_VCENTER
        CTEXT "(c) 2026, OS2World port", -1, 55, 45, 150, 10, DT_VCENTER
        CTEXT "GNU GPL V2", -1, 55, 30, 150, 10, DT_VCENTER
        DEFPUSHBUTTON "~Close", DID_OK, 86, 6, 48, 16
    END
END

/*
 *  Help table definition
 */

HELPTABLE   TEMPLATE_HELP_TABLE
{
    HELPITEM    ID_ClientWindow,       SUBTABLE_MAIN,         PANEL_MAIN
    HELPITEM    ID_HELLO,              SUBTABLE_PRODUCTINFODLG, PANEL_PRODUCTINFODLG
}

