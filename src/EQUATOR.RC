#include <os2.h>
#include "EQUATOR.H"
#include "pmmnwin.h"
#include "pmeqhelp.h"
#include "pmini.h"

ICON ID_ClientWindow EQUATOR.ICO

MENU ID_ClientWindow
BEGIN
    SUBMENU "~Game", IDM_SUBMENU_GAME
    BEGIN
        MENUITEM "~New Puzzle\tCtrl+N", IDM_NEW
        MENUITEM "~Solution\tCtrl+S", IDM_SOLUTION
        MENUITEM "H~ighscores\tCtrl+I", IDM_HISCORE
        MENUITEM SEPARATOR
        MENUITEM "~Level\tCtrl+L", IDM_LEVEL
        MENUITEM "~Hardmode\tCtrl+H", IDM_HARD, MIA_CHECKED
        MENUITEM SEPARATOR
        MENUITEM "~Alpha\tCtrl+A", IDM_ALPHA, MIA_CHECKED
        MENUITEM "Hedgeh~og", IDM_HEDGEHOG, MIA_CHECKED
        MENUITEM SEPARATOR
        MENUITEM "E~xit\tCtrl+X", IDM_EXIT
    END

    SUBMENU "~Options", IDM_SUBMENU_OPTIONS
    BEGIN
        SUBMENU "~Language", IDM_SUBMENU_LANGUAGE
        BEGIN
            MENUITEM "English", IDM_LANG_EN, MIA_CHECKED
            MENUITEM "Espanol", IDM_LANG_ES
            MENUITEM "Nederlands", IDM_LANG_NL
            MENUITEM "Deutsch", IDM_LANG_DE
            MENUITEM "Francais", IDM_LANG_FR
            MENUITEM "Italiano", IDM_LANG_IT
        END

        MENUITEM SEPARATOR

        MENUITEM "~Save settings on exit", IDM_SAVEONEXIT, MIA_CHECKED
    END

    SUBMENU "~Help", IDM_SUBMENU_HELP
    BEGIN
        MENUITEM "Help ~index", IDM_HELPINDEX
        MENUITEM "~General help", IDM_HELPGENERAL
        MENUITEM "~Using help", IDM_HELPUSINGHELP
        MENUITEM "~Keys help", IDM_HELPKEYS
        MENUITEM SEPARATOR
        MENUITEM "~About Equator...", IDM_ABOUT
    END
END

ACCELTABLE ID_ClientWindow
BEGIN
    "n", IDM_NEW, CONTROL
    "s", IDM_SOLUTION, CONTROL
    "i", IDM_HISCORE, CONTROL
    "l", IDM_LEVEL, CONTROL
    "h", IDM_HARD, CONTROL
    "a", IDM_ALPHA, CONTROL
    "x", IDM_EXIT, CONTROL
    VK_F3, IDM_EXIT, VIRTUALKEY
END

STRINGTABLE
BEGIN
    IDS_APPNAME         "Equator"
    IDS_HELPWINDOWTITLE "Equator - Hilfe"
    IDS_HELPLIBRARYNAME "EQUATOR_DE.HLP"
END

MESSAGETABLE
BEGIN
    IDMSG_LEIDERFALSCH  "This wasn't correct!"
    IDMSG_MINDIFF       "It has to be: Upper Level > Lower Level !"
    IDMSG_CANT_INIT     "Can't initialize application!"
    IDMSG_CANT_FRAME    "Can't set first frame!"
    IDMSG_CANT_REGISTER "Can't register window class!"
    IDMSG_CANT_QUEUE    "Can't initialize queue."
    IDMSG_HELPLOADERROR "Failed to load help manager."
    IDMSG_CANNOTLOADSTRING "Failed to load string."
    IDMSG_HELPDISPLAYERROR "Failed to display help panel."
    IDMSG_ALLREADY_RUNNING "Sorry, but you're already playing that game in another window!"
END

